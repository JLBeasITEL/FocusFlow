<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatura estática para el selector de widgets del launcher
     (android:previewImage en tareas_widget_chico_info.xml). Representación
     abstracta de la variante Chico real: encabezado con acento teal +
     ícono de alternancia (SIN badge de conteo, esa variante no lo muestra),
     2 tarjetas con título + fecha + píldora de prioridad, y una línea de
     footer simulando "+N tarea más". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <size android:width="180dp" android:height="180dp" />
            <solid android:color="@color/widget_background" />
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Título ("Próximas") -->
    <item android:left="14dp" android:top="17dp" android:right="56dp" android:bottom="149dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Ícono de alternancia -->
    <item android:left="150dp" android:top="12dp" android:right="12dp" android:bottom="148dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_border" />
        </shape>
    </item>

    <!-- Tarjeta 1 -->
    <item android:left="14dp" android:top="40dp" android:right="14dp" android:bottom="102dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_row_background" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="47dp" android:right="84dp" android:bottom="121dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_primary" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="64dp" android:right="96dp" android:bottom="106dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_tertiary" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="134dp" android:top="62dp" android:right="20dp" android:bottom="104dp">
        <shape android:shape="rectangle">
            <solid android:color="#332196F3" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Tarjeta 2 -->
    <item android:left="14dp" android:top="86dp" android:right="14dp" android:bottom="56dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_row_background" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="93dp" android:right="84dp" android:bottom="75dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_primary" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="110dp" android:right="96dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_date_urgent" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="134dp" android:top="108dp" android:right="20dp" android:bottom="58dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FF9800" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Footer "+N tarea más" -->
    <item android:left="70dp" android:top="136dp" android:right="70dp" android:bottom="36dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_tertiary" />
            <corners android:radius="3dp" />
        </shape>
    </item>

</layer-list>
