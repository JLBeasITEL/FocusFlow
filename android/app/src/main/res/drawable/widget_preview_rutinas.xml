<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatura estática para el selector de widgets del launcher
     (android:previewImage en rutinas_widget_info.xml). Representación
     abstracta: tarjeta redondeada, título en acento teal, 5 filas con
     línea de texto + punto de estado (verde/gris) y un separador fino
     entre filas, igual que el widget real. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <size android:width="250dp" android:height="300dp" />
            <solid android:color="@color/widget_background" />
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Título ("Rutinas de hoy") -->
    <item android:left="14dp" android:top="14dp" android:right="90dp" android:bottom="272dp">
