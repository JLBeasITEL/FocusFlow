<?xml version="1.0" encoding="utf-8"?>
<!-- Anillo estático en 0% para las miniaturas previewLayout de Progreso: los
     anillos reales se dibujan en un Canvas desde Kotlin (ver
     ProgresoWidgetProviderChico/Grande), algo que un <shape> no puede
     replicar, pero como las miniaturas muestran el estado "recién instalado"
     (0/0 y 0/2, es decir 0% de avance) un aro liso sin relleno coincide
     exactamente con ese estado real. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="ring"
    android:innerRadiusRatio="3.2"
    android:thickness="8dp"
    android:useLevel="false">
    <solid android:color="@color/widget_progress_vacio" />
</shape>
