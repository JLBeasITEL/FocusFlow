<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatura estática para el selector de widgets del launcher
     (android:previewImage en tareas_widget_grande_info.xml). Representación
     abstracta de la variante Grande real: encabezado con acento teal +
     badge de conteo total + ícono de alternancia, y 4 tarjetas con título +
     fecha + píldora de prioridad. -->
