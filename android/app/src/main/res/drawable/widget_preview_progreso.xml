<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatura estática para el selector de widgets del launcher, usada por
     ambas variantes (mismo criterio que widget_preview_rutinas.xml y
     widget_preview_notas.xml). Representación abstracta: tarjeta redondeada,
     título en acento teal y dos anillos de progreso (azul para Tareas, teal
     para Rutinas) uno junto al otro, igual que el widget Grande real. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <size android:width="280dp" android:height="180dp" />
            <solid android:color="@color/widget_background" />
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Título ("Progreso") -->
    <item android:left="16dp" android:top="16dp" android:right="200dp" android:bottom="152dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Anillo Tareas (azul) -->
    <item android:left="24dp" android:top="46dp" android:right="196dp" android:bottom="26dp">
        <shape android:shape="oval">
            <stroke android:width="8dp" android:color="@color/widget_progress_tareas" />
        </shape>
    </item>

    <!-- Anillo Rutinas (teal) -->
    <item android:left="156dp" android:top="46dp" android:right="64dp" android:bottom="26dp">
        <shape android:shape="oval">
            <stroke android:width="8dp" android:color="@color/widget_accent" />
        </shape>
    </item>

</layer-list>
