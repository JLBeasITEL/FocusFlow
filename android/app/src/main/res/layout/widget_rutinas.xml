<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_rutinas_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rutinas de hoy"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Filas de una sola línea, deliberadamente sin fondo/tarjeta por fila
         (a diferencia del widget de Tareas): el usuario pidió expresamente
         que quepan al menos 5 rutinas en el alto real de un widget ya
         colocado (~124dp en pruebas previas), así que el presupuesto
         vertical por fila se mantiene casi igual al de antes; el toque
         estético va en la tarjeta redondeada exterior, el título en color
         de acento y el color/negrita del estado (ver RutinasWidgetProvider). -->

    <!-- Fila 1 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_rutinas_titulo1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_rutinas_hora1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/widget_rutinas_estado_dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_dot" />
        <TextView
            android:id="@+id/widget_rutinas_estado_label1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textStyle="bold"
            android:textSize="9sp" />
    </LinearLayout>

