<?xml version="1.0" encoding="utf-8"?>
<!-- match_parent en ambas dimensiones (no un dp fijo ni wrap_content): en
     launchers modernos con grid "responsive", un widget resizeMode="none"
     igual puede terminar con un host bastante más grande que el minWidth/
     minHeight declarados en tareas_widget_grande_info.xml (el sistema
     reserva celdas completas, no el tamaño exacto pedido). Con wrap_content
     el fondo del widget solo envolvía el contenido real, dejando un margen
     enorme de wallpaper alrededor de una tarjeta chica. match_parent hace
     que el fondo llene lo que el host le haya dado, y el bloque de filas se
     centra verticalmente en ese espacio (ver content_wrapper más abajo) en
     vez de quedar pegado arriba con todo el resto vacío debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tareas_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_tareas_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Próximas"
            android:textColor="@color/widget_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tareas_contador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_tareas_toggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="2dp"
            android:src="@drawable/ic_widget_swap"
            android:contentDescription="Alternar entre próximas y más importantes" />

    </LinearLayout>

    <!-- Envuelve las 4 tarjetas + footer/vacío: 0dp+weight=1 hace que este
         bloque ocupe todo el alto que sobra debajo del header, y
         gravity="center_vertical" centra las filas dentro de ese espacio en
         vez de dejarlas pegadas arriba. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

    <!-- Tarjeta 1 -->
    <LinearLayout
        android:id="@+id/widget_tareas_fila1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <TextView
            android:id="@+id/widget_tareas_titulo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tareas_fecha1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_tareas_prioridad1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_medio"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta 2 -->
    <LinearLayout
        android:id="@+id/widget_tareas_fila2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <TextView
            android:id="@+id/widget_tareas_titulo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tareas_fecha2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_tareas_prioridad2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_medio"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta 3 -->
    <LinearLayout
        android:id="@+id/widget_tareas_fila3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <TextView
            android:id="@+id/widget_tareas_titulo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tareas_fecha3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_tareas_prioridad3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_medio"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta 4 -->
    <LinearLayout
        android:id="@+id/widget_tareas_fila4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <TextView
            android:id="@+id/widget_tareas_titulo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tareas_fecha4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_tareas_prioridad4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_medio"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_tareas_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_tareas_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:text="Sin tareas pendientes"
        android:textColor="@color/widget_text_tertiary"
        android:textStyle="italic"
        android:textSize="13sp"
        android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
