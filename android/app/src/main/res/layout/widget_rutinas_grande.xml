<?xml version="1.0" encoding="utf-8"?>
<!-- match_parent en ambas dimensiones (no wrap_content): en launchers
     modernos con grid "responsive", un widget resizeMode="none" igual puede
     terminar con un host bastante más grande que el minWidth/minHeight
     declarados en rutinas_widget_grande_info.xml (el sistema reserva celdas
     completas, no el tamaño exacto pedido). Con wrap_content el fondo del
     widget solo envolvía el contenido real, dejando un margen enorme de
     wallpaper alrededor de una tarjeta chica. match_parent hace que el
     fondo llene lo que el host le haya dado, y el bloque de filas se centra
     verticalmente en ese espacio (ver content_wrapper más abajo) en vez de
     quedar pegado arriba con todo el resto vacío debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rutinas_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rutinas de hoy"
            android:textColor="@color/widget_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_rutinas_contador_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_rutinas_hechas_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_rutinas_contador_resto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/widget_rutinas_progreso_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress_rutinas" />

        </LinearLayout>

    </LinearLayout>

    <!-- Envuelve las 4 tarjetas + footer/vacío: 0dp+weight=1 hace que este
         bloque ocupe todo el alto que sobra debajo del header, y
         gravity="center_vertical" centra las filas dentro de ese espacio en
         vez de dejarlas pegadas arriba. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

    <!-- Tarjeta 1 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <ImageView
            android:id="@+id/widget_rutinas_check1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_check_empty"
            android:contentDescription="Marcar rutina como hecha" />
        <TextView
            android:id="@+id/widget_rutinas_hora1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hora_pendiente"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_rutinas_titulo1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_badge1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hecha"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tarjeta 2 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <ImageView
            android:id="@+id/widget_rutinas_check2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_check_empty"
            android:contentDescription="Marcar rutina como hecha" />
        <TextView
            android:id="@+id/widget_rutinas_hora2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hora_pendiente"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_rutinas_titulo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_badge2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hecha"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tarjeta 3 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <ImageView
            android:id="@+id/widget_rutinas_check3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_check_empty"
            android:contentDescription="Marcar rutina como hecha" />
        <TextView
            android:id="@+id/widget_rutinas_hora3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hora_pendiente"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_rutinas_titulo3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_badge3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hecha"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tarjeta 4 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <ImageView
            android:id="@+id/widget_rutinas_check4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_check_empty"
            android:contentDescription="Marcar rutina como hecha" />
        <TextView
            android:id="@+id/widget_rutinas_hora4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hora_pendiente"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_rutinas_titulo4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_badge4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hecha"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_rutinas_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_rutinas_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/widget_empty_dashed_border"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Día libre"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="No hay rutinas programadas para hoy."
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_programar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/widget_button_pill"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Programar rutina"
            android:textColor="@color/widget_accent"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    </LinearLayout>

</LinearLayout>
