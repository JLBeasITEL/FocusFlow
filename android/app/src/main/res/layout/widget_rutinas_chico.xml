<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rutinas_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rutinas"
            android:textColor="@color/widget_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_rutinas_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="1dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Actualizar rutinas" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_rutinas_contador_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_rutinas_hechas_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_rutinas_contador_resto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="hoy"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Tarjeta 1 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <TextView
            android:id="@+id/widget_rutinas_hora1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hora_pendiente"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_rutinas_titulo1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_badge1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hecha"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tarjeta 2 -->
    <LinearLayout
        android:id="@+id/widget_rutinas_fila2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_background"
        android:padding="10dp">
        <TextView
            android:id="@+id/widget_rutinas_hora2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hora_pendiente"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_rutinas_titulo2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_rutinas_badge2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_hecha"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_rutinas_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_rutinas_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Día libre"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="No hay rutinas programadas para hoy."
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_rutinas_programar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_button_pill"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Programar rutina"
            android:textColor="@color/widget_accent"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
